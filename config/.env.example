# Environment Variables Template
# For Contact AutoPilot React Native SaaS App
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# APP CONFIGURATION
# ============================================

# App Name
APP_NAME=Contact AutoPilot
APP_DISPLAY_NAME=Contact AutoPilot

# Bundle Identifiers
IOS_BUNDLE_ID=com.yourcompany.contactautopilot
ANDROID_PACKAGE_NAME=com.yourcompany.contactautopilot

# App Version
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1

# ============================================
# API ENDPOINTS
# ============================================

# Production API
API_URL=https://api.contactautopilot.com/v1

# Staging API (for development)
API_URL_STAGING=https://staging-api.contactautopilot.com/v1

# Web Dashboard URL
WEB_URL=https://app.contactautopilot.com

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Firebase Project Settings
FIREBASE_PROJECT_ID=contactautopilot-prod
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=contactautopilot-prod.appspot.com

# ============================================
# THIRD-PARTY SERVICES
# ============================================

# Analytics
# Amplitude
AMPLITUDE_API_KEY=your-amplitude-key

# Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token

# Segment
SEGMENT_WRITE_KEY=your-segment-key

# Crash Reporting
# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Bugsnag
BUGSNAG_API_KEY=your-bugsnag-key

# Push Notifications
# OneSignal
ONESIGNAL_APP_ID=your-onesignal-app-id

# Pusher
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=us2

# Authentication
# Auth0
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Apple Sign-In
APPLE_SIGN_IN_CLIENT_ID=com.yourcompany.contactautopilot

# Social Media
# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_CLIENT_TOKEN=your-facebook-client-token

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# Payment Processing
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_key
STRIPE_MERCHANT_ID=your-merchant-id

# RevenueCat
REVENUECAT_API_KEY=your-revenuecat-key

# ============================================
# IOS BUILD CONFIGURATION
# ============================================

# Apple Developer Account
APPLE_ID=your-email@example.com
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_ITC_TEAM_ID=YOUR_ITC_TEAM_ID

# Code Signing
# Use match for certificate management
MATCH_GIT_URL=https://github.com/yourorg/certificates
MATCH_PASSWORD=your-match-password
MATCH_TYPE=appstore

# App Store Connect API Key (recommended for CI/CD)
APP_STORE_CONNECT_API_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_ID=your-key-id
APP_STORE_CONNECT_API_ISSUER_ID=your-issuer-id

# Provisioning Profiles
PROVISIONING_PROFILE_SPECIFIER=match AppStore com.yourcompany.contactautopilot

# ============================================
# ANDROID BUILD CONFIGURATION
# ============================================

# Keystore Configuration
ANDROID_KEYSTORE_PATH=./android/app/contactautopilot.keystore
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=contactautopilot
ANDROID_KEY_PASSWORD=your-key-password

# Play Store API Access
PLAY_STORE_JSON_KEY_PATH=./fastlane/play-store-key.json

# ============================================
# FASTLANE CONFIGURATION
# ============================================

# Fastlane Settings
FASTLANE_SKIP_UPDATE_CHECK=true
FASTLANE_HIDE_CHANGELOG=true
FASTLANE_DISABLE_COLORS=false

# Slack Integration
SLACK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#mobile-releases

# Git Configuration
FL_GIT_COMMIT_SHOULD_NOT_BE_DIRTY=false
FL_GIT_COMMIT_SKIP_NO_CHANGES=false

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================

# Deployment Targets
DEPLOYMENT_TARGET_IOS=12.0
DEPLOYMENT_TARGET_ANDROID=24

# Build Configuration
BUILD_CONFIGURATION=Release
EXPORT_METHOD=app-store

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/Disable Features
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_IN_APP_PURCHASES=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_OFFLINE_MODE=true

# Debug Features (disable in production)
ENABLE_DEBUG_MENU=false
ENABLE_LOGGING=false
ENABLE_MOCK_DATA=false

# ============================================
# SECURITY
# ============================================

# Certificate Pinning
CERTIFICATE_PINNING_ENABLED=true

# Encryption Keys (use secure key management in production)
ENCRYPTION_KEY=your-encryption-key

# JWT Configuration
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=86400

# ============================================
# DEVELOPMENT
# ============================================

# Metro Configuration
REACT_NATIVE_PACKAGER_HOSTNAME=localhost
RCT_METRO_PORT=8081

# Flipper (debugging tool)
FLIPPER_ENABLED=true

# Hermes
HERMES_ENABLED=true

# New Architecture (Fabric/TurboModules)
NEW_ARCH_ENABLED=false

# ============================================
# TESTING
# ============================================

# Test Configuration
TEST_API_URL=http://localhost:3000
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test-password

# E2E Testing
DETOX_CONFIGURATION=ios.sim.debug

# ============================================
# LOCALIZATION
# ============================================

# Default Language
DEFAULT_LANGUAGE=en

# Supported Languages
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh

# ============================================
# SUPPORT
# ============================================

# Support URLs
SUPPORT_URL=https://contactautopilot.com/support
PRIVACY_POLICY_URL=https://contactautopilot.com/privacy
TERMS_OF_SERVICE_URL=https://contactautopilot.com/terms
FAQ_URL=https://contactautopilot.com/faq

# Support Contact
SUPPORT_EMAIL=support@contactautopilot.com
SUPPORT_PHONE=+1-800-555-0123

# ============================================
# NOTES
# ============================================

# 1. Never commit this file with real values to version control
# 2. Use different .env files for different environments:
#    - .env.development
#    - .env.staging
#    - .env.production
#
# 3. For CI/CD, set these as environment variables in your CI system
# 4. For local development, use a .env.local file
# 5. For sensitive values, consider using a secrets manager
