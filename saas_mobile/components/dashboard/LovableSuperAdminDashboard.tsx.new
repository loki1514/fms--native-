// ─── Types ────────────────────────────────────────────────────────────────────
type Screen = 'properties' | 'property-detail' | 'console' | 'analytics';
type Tab = 'overview' | 'organizations' | 'users' | 'profile';

interface Property {
  id: string;
  name: string;
  code: string;
  address?: string;
  image_url?: string | null;
  openTickets?: number;
  resolvedTickets?: number;
  totalTickets?: number;
  healthStatus?: 'good' | 'warning' | 'critical';
  checklist?: { completed: number; total: number };
  energy?: { current: number; trend: number };
  tickets?: { day: string; count: number }[];
  status?: 'optimal' | 'warning' | 'critical';
  high?: number;
  low?: number;
}

interface TicketStats {
  raisedToday: number;
  dailyAvg: number;
  total: number;
  byStatus: { open: number; inProgress: number; resolved: number };
  history: { day: string; count: number }[];
}

interface Org {
  id: string;
  name: string;
  code: string;
  is_deleted: boolean;
  properties?: { count: number }[];
}

interface SystemUser {
  id: string;
  full_name: string;
  email: string;
  phone?: string | null;
}

