# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App Configuration
EXPO_PUBLIC_APP_NAME=Autopilot
EXPO_PUBLIC_APP_VERSION=1.0.0

# API Configuration (if using custom backend)
# EXPO_PUBLIC_API_URL=https://api.yourapp.com

# Voice Agent Backend Proxy — set to your deployed Next.js app URL.
# All voice AI calls (intent, response, TTS) are routed through this proxy
# to keep OpenAI and Supermemory API keys server-side.
# If not set, the app falls back to template-based responses (no LLM).
EXPO_PUBLIC_VOICE_API_URL=https://your-project.vercel.app

# ── Cassandra Voice Enrollment ──────────────────────────────────────────────────
# ECAPA-TDNN speaker embedding server. Enrollment calls are proxied through
# the /api/voice/enroll route (server-side) so API keys stay off the client.
# Format: http://<host>:<port>/enroll
EXPO_PUBLIC_CASSANDRA_ECAPA_URL=http://localhost:8001/enroll

# ── Autopilot Organization ─────────────────────────────────────────────────────
# Used by onboarding to filter properties for the onboarding org.
EXPO_PUBLIC_AUTOPILOT_ORG_ID=your-autopilot-org-id

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASHLYTICS=true
