# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── IMPORTANT ─────────────────────────────────────────────────────────────────
# API keys below are kept here only for reference.
# NEVER commit actual key values to version control.
# Use .env.local for local development with real keys (already gitignored).
# For production, set these via your deployment platform's secrets manager.
# ────────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (used server-side only via /api/voice proxy — never exposed to client in production)
# EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key

# Supermemory API Key (used server-side only via /api/voice proxy)
# EXPO_PUBLIC_SUPERMEMORY_API_KEY=your-supermemory-api-key

# Groq API Keys (used server-side only via /api/voice proxy)
# EXPO_PUBLIC_GROQ_API_KEY=your-groq-api-key
# EXPO_PUBLIC_GROQ_LAYOUT_API_KEY=your-groq-layout-api-key

# App Configuration
EXPO_PUBLIC_APP_NAME=Autopilot
EXPO_PUBLIC_APP_VERSION=1.0.0

# API Configuration (if using custom backend)
# EXPO_PUBLIC_API_URL=https://api.yourapp.com

# Voice Agent Backend Proxy — set to your deployed Next.js app URL.
# All voice AI calls (intent, response, TTS) are routed through this proxy
# to keep OpenAI and Supermemory API keys server-side.
# If not set, the app falls back to template-based responses (no LLM).
EXPO_PUBLIC_VOICE_API_URL=https://your-project.vercel.app

# ── Cassandra Voice Enrollment ──────────────────────────────────────────────────
# ECAPA-TDNN speaker embedding server. Enrollment calls are proxied through
# the /api/voice/enroll route (server-side) so API keys stay off the client.
# Format: http://<host>:<port>/enroll
EXPO_PUBLIC_CASSANDRA_ECAPA_URL=http://localhost:8001/enroll

# ── Cassandra AI Backend ─────────────────────────────────────────────────────
# REST API base URL — for /health, /auth/session, /api/v1/* endpoints
# For local preflight testing with the FastAPI voice server:
#   iOS Simulator / web: http://localhost:8000
#   Android Emulator:    http://10.0.2.2:8000
#   Physical device:     http://<your-computer-ip>:8000
EXPO_PUBLIC_CASSANDRA_API_URL=https://your-cassandra-backend.example.com

# WebSocket URL — for real-time voice streaming via /ws/audio/{org_id}
# Use wss:// in production (SSL required for WebSocket upgrade)
# For local preflight testing:
#   iOS Simulator / web: ws://localhost:8000
#   Android Emulator:    ws://10.0.2.2:8000
#   Physical device:     ws://<your-computer-ip>:8000
EXPO_PUBLIC_CASSANDRA_WS_URL=wss://your-cassandra-backend.example.com

# ── Autopilot Organization ─────────────────────────────────────────────────────
# Used by onboarding to filter properties for the onboarding org.
EXPO_PUBLIC_AUTOPILOT_ORG_ID=your-autopilot-org-id

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASHLYTICS=true
